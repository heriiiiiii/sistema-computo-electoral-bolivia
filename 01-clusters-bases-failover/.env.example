# =============================================================================
#  Sistema Nacional de Cómputo Electoral Bolivia
#  Module 01 — Environment Variables Example
#
#  Copy this file to .env and adjust values if needed.
#  These are demo credentials — DO NOT use in production.
# =============================================================================

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/La_Paz

# ── MongoDB Replica Set ────────────────────────────────────────────────────────
MONGO_REPLICA_SET=rs0
MONGO_DB=oep_rrv

# Individual node ports (host-side)
MONGO_PORT_1=27017
MONGO_PORT_2=27018
MONGO_PORT_3=27019

# Connection URI for NestJS / backend services (use inside Docker network)
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/oep_rrv?replicaSet=rs0

# Connection URI from the host machine (for testing with Compass, mongosh, etc.)
MONGO_URI_HOST=mongodb://localhost:27017,localhost:27018,localhost:27019/oep_rrv?replicaSet=rs0

# ── PostgreSQL Primary ─────────────────────────────────────────────────────────
POSTGRES_DB=oep_oficial
POSTGRES_USER=oep_user
POSTGRES_PASSWORD=oep_password
POSTGRES_PRIMARY_PORT=5432

# Primary connection URL (use inside Docker network)
POSTGRES_PRIMARY_URL=postgresql://oep_user:oep_password@postgres-primary:5432/oep_oficial

# Primary connection URL from the host machine
POSTGRES_PRIMARY_URL_HOST=postgresql://oep_user:oep_password@localhost:5432/oep_oficial

# ── PostgreSQL Replica ─────────────────────────────────────────────────────────
POSTGRES_REPLICA_PORT=5433

# Replica connection URL (use inside Docker network)
POSTGRES_REPLICA_URL=postgresql://oep_user:oep_password@postgres-replica:5432/oep_oficial

# Replica connection URL from the host machine
POSTGRES_REPLICA_URL_HOST=postgresql://oep_user:oep_password@localhost:5433/oep_oficial

# ── Replication User (internal, not for backend services) ─────────────────────
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_password

# ── PostgreSQL Router (HAProxy) ───────────────────────────────────────────────
# Stable endpoint — always connects to the current writable PRIMARY.
# Use this instead of POSTGRES_PRIMARY_URL to avoid reconfiguring after failover.
# Inside Docker network:
POSTGRES_ROUTER_URL=postgresql://oep_user:oep_password@postgres-router:5432/oep_oficial
# From host machine (port 5434):
POSTGRES_ROUTER_HOST_URL=postgresql://oep_user:oep_password@localhost:5434/oep_oficial

# ── Automatic Failover Monitor (used when running from host) ──────────────────
# When running as Docker Compose service these are set in docker-compose.yml.
# Set PG_REPLICA_PORT=5433 when running from host (outside Docker network).
PG_PRIMARY_HOST=localhost
PG_PRIMARY_PORT=5432
PG_REPLICA_HOST=localhost
PG_REPLICA_PORT=5433
PG_USER=oep_user
PG_PASSWORD=oep_password
PG_DB=oep_oficial
CHECK_INTERVAL_MS=5000
FAILURE_THRESHOLD=3

# ── Backup Settings ────────────────────────────────────────────────────────────
BACKUP_DIR=./postgres/backups

# MongoDB backup directory (relative to module root)
MONGO_BACKUP_DIR=./mongo/backups
