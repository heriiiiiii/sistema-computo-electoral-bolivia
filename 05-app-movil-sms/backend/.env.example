# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Gateway SMS ───────────────────────────────────────────────────────────────
# Tipo de gateway: 'twilio' | 'africastalking' | 'generic'
SMS_GATEWAY_TYPE=generic

# Número que recibe los SMS de los delegados (debe coincidir con la app Flutter)
SMS_RECIPIENT_NUMBER=+59171440740

# Secreto compartido con el gateway para verificar firmas de webhook.
# En Twilio: usar el Auth Token de la cuenta.
# En genérico: definir una clave propia y configurar el gateway para enviarla.
SMS_WEBHOOK_SECRET=

# Si se activa, rechaza requests con firma inválida. Desactivar en desarrollo.
ENFORCE_WEBHOOK_SIGNATURE=false
