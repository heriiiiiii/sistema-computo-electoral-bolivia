# ============================================================
# Sistema Nacional de Cómputo Electoral Bolivia
# .gitignore general del repositorio
# ============================================================


# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*


# ──────────────────────────────────────────────
# Reportes / diagnóstico
# ──────────────────────────────────────────────
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# ──────────────────────────────────────────────
# Runtime / procesos
# ──────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock


# ──────────────────────────────────────────────
# Node / npm / pnpm / yarn
# ──────────────────────────────────────────────
node_modules/
**/node_modules/
jspm_packages/
bower_components/
web_modules/

.npm/
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

*.tgz
.node_repl_history


# ──────────────────────────────────────────────
# TypeScript / Vite / Frontend builds
# ──────────────────────────────────────────────
*.tsbuildinfo
.vite/
**/.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

dist/
**/dist/
build/
**/build/
out/
.output/

03-flujo-oficial/backend/dist/
03-flujo-oficial/frontend/dist/
04-dashboard-avanzado/dist/


# ──────────────────────────────────────────────
# Framework caches
# ──────────────────────────────────────────────
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.vuepress/dist/
.temp/
**/.vitepress/dist/
**/.vitepress/cache/
.docusaurus/
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port


# ──────────────────────────────────────────────
# Testing / coverage
# ──────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
.grunt/
lib-cov/
.eslintcache
.stylelintcache


# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
**/env/
**/ENV/

pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/


# ──────────────────────────────────────────────
# Variables de entorno / archivos sensibles
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

*.pem
*.key
*.crt
secrets/


# ──────────────────────────────────────────────
# Docker / datos locales / volúmenes
# ──────────────────────────────────────────────
**/pgdata/
**/postgres-data/
**/mongo-data/
**/mongodb-data/
**/redis-data/
**/n8n-data/
**/data/
**/_data/


# ──────────────────────────────────────────────
# Archivos temporales de procesamiento
# OCR / CSV / actas / reportes generados
# ──────────────────────────────────────────────
tmp/
temp/
uploads/
**/tmp/
**/temp/
**/uploads/
**/storage/local/

02-flujo-rapido-rrv/storage/actas/
02-flujo-rapido-rrv/storage/debug_ocr/
02-flujo-rapido-rrv/storage/reportes_lote/


# ──────────────────────────────────────────────
